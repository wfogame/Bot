+// True when an item is a spawner (mob/monster spawner). Matches the registry
+// name first, then falls back to display/custom names so renamed server
+// spawners like "§bZombie Spawner" are still recognised.
+function isSpawnerItem (item) {
+if (!item) return false
+const names = [item.name, item.displayName, itemCustomName(item)].filter(Boolean)
+return names.some(n => /spawner/i.test(String(n)))
