# Dashboard
WEB_GUI=true
WEB_PASSWORD=change-this-dashboard-password

# bot.js controls (see docs/bot-controls.md)
# Delay between /all-slow dispatches, in milliseconds. Default: 15000 (15s).
ALL_SLOW_DELAY_MS=15000
# Shuffle initial bot connection order. Set false to keep BOT_NAMES order.
RANDOMIZE_BOT_ORDER=true

# SSH terminal connection to the main host
WEB_TERMINAL_ENABLED=true
SSH=true
SSH_HOST=OnlyAProgrammer
SSH_PORT=22
SSH_USER=your-ssh-username
SSH_PASSWORD=your-ssh-password
SSH_HOST_KEY_FINGERPRINT=SHA256:your-host-key-fingerprint
SSH_READY_TIMEOUT_MS=10000

# Discord and memory monitoring
DISCORD_NOTIFICATIONS=true
DISCORD_WEBHOOK_URL=
DISCORD_USER_ID=
DISCORD_MENTION_CRITICAL_ONLY=false
DISCORD_MIN_SEND_INTERVAL_MS=1200
DISCORD_EVENT_COOLDOWN_MS=60000
SERVER_RESTART_ALERT_COOLDOWN_MS=120000

MEMORY_WATCHDOG=true
MEMORY_CHECK_INTERVAL_MS=30000
MEMORY_AVAILABLE_WARN_PERCENT=15
MEMORY_AVAILABLE_CRITICAL_PERCENT=8
SWAP_WARN_PERCENT=10
SWAP_WARN_MIB=256
MEMORY_ALERT_COOLDOWN_MS=900000
MEMORY_RECOVERY_PERCENT=20

# Outbound proxy (applies to all bots unless overridden by a PROXY_GROUP below)
PROXY_HOST=
PROXY_PORT=1080
PROXY_TYPE=socks5

# Dedicated per-bot proxy groups (SOCKS5/HTTP). Add as many PROXY_GROUP_<N>_* sets as needed,
# starting at N=1 with no gaps. Bots not listed in any group use PROXY_HOST above (or connect
# directly if that is also empty).
# PROXY_GROUP_1_BOTS=Bot1,Bot2
# PROXY_GROUP_1_HOST=1.2.3.4
# PROXY_GROUP_1_PORT=1080
# PROXY_GROUP_1_TYPE=socks5
# PROXY_GROUP_2_BOTS=Bot3
# PROXY_GROUP_2_HOST=5.6.7.8
# PROXY_GROUP_2_PORT=1080
# PROXY_GROUP_2_TYPE=http
